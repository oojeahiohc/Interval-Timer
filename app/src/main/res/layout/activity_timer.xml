<?xml version="1.0" encoding="utf-8"?>
<!-- activity_timer.xml: 운동·휴식·완료 상태의 타이머 화면 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_bg"
    android:fitsSystemWindows="true">

    <!-- 화면 패딩은 시스템 영역과 분리한다. -->
    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/clay_screen_padding">

        <!-- 현재 운동 또는 휴식 구간 -->
        <TextView
            android:id="@+id/timerPhaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/work_phase"
            android:textColor="@color/clay_text"
            android:textSize="28sp" />

        <!-- 현재 구간의 남은 시간 -->
        <TextView
            android:id="@+id/timerRemainingText"
            style="@style/ClaySurface"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_timer_panel"
            android:gravity="center"
            android:text="@string/demo_time"
            android:textColor="@color/clay_text"
            android:textSize="52sp"
            android:textStyle="bold" />

        <!-- 현재 세트 / 전체 세트 -->
        <TextView
            android:id="@+id/timerRoundText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/demo_round"
            android:textColor="@color/clay_text"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            style="@style/ClayButton"
            android:id="@+id/startTimerButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clay_button_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_work"
            android:text="@string/start" />

        <!-- 실행 중에는 일시정지, 정지 중에는 재개만 표시한다. -->
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:id="@+id/controlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/clay_button_height"
                android:layout_weight="1"
                android:background="@drawable/bg_button_work"
                android:text="@string/pause" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/resumeButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/clay_button_height"
                android:layout_weight="1"
                android:background="@drawable/bg_button_work"
                android:text="@string/resume"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/clay_button_height"
                android:layout_marginStart="@dimen/clay_small_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="@string/stop" />
        </LinearLayout>

        <!-- 운동 완료 시 표시할 영역 -->
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:id="@+id/completedState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/completed"
                android:textColor="@color/clay_text"
                android:textSize="24sp" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/backToListButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clay_button_height"
                android:layout_marginTop="@dimen/clay_small_gap"
                android:background="@drawable/bg_button_primary"
                android:text="@string/back_to_list" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

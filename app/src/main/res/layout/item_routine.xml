<?xml version="1.0" encoding="utf-8"?>
<!-- item_routine.xml: 목록의 루틴 카드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_clay"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="@dimen/clay_content_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/routineNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/clay_text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/editRoutineButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clay_button_height"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="@string/edit"
            android:textColor="@color/clay_text" />

        <Button
            android:id="@+id/deleteRoutineButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clay_button_height"
            android:layout_marginStart="@dimen/clay_small_gap"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="@string/delete"
            android:textColor="@color/clay_text" />
    </LinearLayout>

    <!-- 운동, 휴식 시간과 세트 수 -->
    <TextView
        android:id="@+id/routineSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clay_small_gap"
        android:textColor="@color/clay_text"
        android:textSize="15sp" />

    <!-- 타이머 화면 이동 버튼 -->
    <Button
        android:id="@+id/startRoutineButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clay_button_height"
        android:layout_marginTop="@dimen/clay_small_gap"
        android:background="@drawable/bg_button_work"
        android:backgroundTint="@null"
        android:text="@string/open_routine"
        android:textColor="@color/clay_on_work" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml: 루틴 목록 화면 -->

<!-- 시스템 상태 표시줄 영역 처리 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_app_bg"
    android:fitsSystemWindows="true">

    <!-- 화면 콘텐츠의 좌우 및 상하 여백 유지 -->
    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/clay_screen_padding">

        <!-- 화면 제목 및 루틴 추가 버튼 -->
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/list_title"
                android:textColor="@color/clay_text"
                android:textSize="24sp" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/addRoutineButton"
                android:layout_width="@dimen/clay_button_height"
                android:layout_height="@dimen/clay_button_height"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="@string/add_routine"
                android:text="@string/add_symbol"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- 루틴 카드 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/routineRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/clay_small_gap"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="@dimen/clay_small_gap"
            android:paddingTop="@dimen/clay_small_gap" />

        <!-- 목록이 비어 있을 때 표시할 안내 영역 -->
        <LinearLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:id="@+id/emptyState"
            style="@style/ClaySurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/clay_content_padding"
            android:background="@drawable/bg_card_clay">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/empty_routines"
                android:textColor="@color/clay_text"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/ClayButton"
                android:id="@+id/emptyAddButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clay_button_height"
                android:layout_marginTop="@dimen/clay_small_gap"
                android:background="@drawable/bg_button_primary"
                android:text="@string/add_routine" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>

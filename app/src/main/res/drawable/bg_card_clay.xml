<?xml version="1.0" encoding="utf-8"?>
<!-- bg_card_clay.xml: 루틴 카드 배경 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 아래로 드리운 그림자 면 -->
    <item android:left="3dp" android:top="6dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_shadow" />
            <corners android:radius="@dimen/clay_card_radius" />
        </shape>
    </item>

    <!-- 밝은 위쪽과 부드러운 카드 표면 -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/clay_highlight"
                android:centerColor="@color/clay_surface"
                android:endColor="@color/clay_surface_2" />
            <corners android:radius="@dimen/clay_card_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/clay_stroke_light" />
        </shape>
    </item>
</layer-list>
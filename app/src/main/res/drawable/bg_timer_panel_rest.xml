<?xml version="1.0" encoding="utf-8"?>
<!-- bg_timer_panel_rest.xml: REST 상태의 타이머 패널 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 아래쪽의 짙은 그림자 -->
    <item android:left="3dp" android:top="6dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rest_dark" />
            <corners android:radius="@dimen/clay_timer_radius" />
        </shape>
    </item>

    <!-- 밝은 상단과 주황색 표면 -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/rest_light"
                android:endColor="@color/color_rest" />
            <corners android:radius="@dimen/clay_timer_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/rest_outline" />
        </shape>
    </item>
</layer-list>
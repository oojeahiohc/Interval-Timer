<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_work" />
                <corners android:radius="@dimen/clay_button_radius" />
                <stroke android:width="1dp" android:color="@color/color_secondary" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/color_rest" android:endColor="@color/color_work" />
            <corners android:radius="@dimen/clay_button_radius" />
            <stroke android:width="1dp" android:color="@color/color_rest" />
        </shape>
    </item>
</selector>

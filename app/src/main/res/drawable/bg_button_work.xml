<?xml version="1.0" encoding="utf-8"?>
<!-- 운동 강조 버튼 배경 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 눌림 상태 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/work_dark"
                android:endColor="@color/color_work" />
            <corners android:radius="@dimen/clay_button_radius" />
        </shape>
    </item>

    <!-- 기본 상태: 그림자 + 운동 강조색 그라데이션 -->
    <item>
        <layer-list>
            <item android:left="2dp" android:top="4dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/work_dark" />
                    <corners android:radius="@dimen/clay_button_radius" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/work_light"
                        android:endColor="@color/color_work" />
                    <corners android:radius="@dimen/clay_button_radius" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/work_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClaySurface">
        <item name="android:elevation">4dp</item>
        <item name="android:outlineProvider">background</item>
    </style>

    <style name="ClayButton" parent="Widget.AppCompat.Button">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">@dimen/clay_button_height</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">3dp</item>
        <item name="android:textColor">@color/clay_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ClayInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:minHeight">@dimen/clay_button_height</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/clay_text</item>
    </style>
</resources>
